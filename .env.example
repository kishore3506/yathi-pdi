# Google Gemini API (image/document analysis)
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_EXTRACTION_TIMEOUT_SECONDS=90
APP_ENV=development
APP_VERSION=local
LOG_LEVEL=INFO
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_MAX_AGE_SECONDS=28800
PUBLIC_APP_ORIGIN=http://127.0.0.1:8000
MAX_UPLOAD_BYTES=26214400
MAX_BACKUP_IMPORT_BYTES=1073741824

# Override these in production so they point to the mounted persistent disk.
PDI_DATA_DIR=./backend
# Optional file and database path overrides:
# PDI_DATABASE_PATH=./backend/pdi_system.db
# PDI_UPLOAD_DIR=./backend/uploads
# PDI_REPORTS_DIR=./backend/generated_reports
# PDI_TEMPLATE_STORAGE_DIR=./backend/user_templates
# PDI_LOG_DIR=./backend/logs
# PDI_BACKUP_DIR=./backend/backups
PDI_LOG_MAX_BYTES=10485760
PDI_LOG_BACKUP_COUNT=10

# Gmail SMTP (use a Google App Password, not your account password)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
# Optional comma-separated list of verified Gmail send-as aliases
GMAIL_ALLOWED_FROM_EMAILS=

# Preferred production delivery: company-owned n8n over public HTTPS.
# Configure only one delivery method. Never use a laptop's localhost URL here.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_FROM_EMAIL=

# Server Configuration
HOST=127.0.0.1
PORT=8000
