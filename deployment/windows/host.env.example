# Copy this file to C:\ProgramData\Yathi Pumps PDI\config\.env.
# Replace the internal HTTPS hostname and Gemini key; never put real secrets in a release ZIP.
APP_ENV=production
APP_VERSION=from-release-manifest
LOG_LEVEL=INFO
PUBLIC_APP_ORIGIN=https://pdi.replace-with-company-dns-name
SESSION_SECRET=__GENERATE_DURING_INSTALL__
SESSION_MAX_AGE_SECONDS=28800

PDI_DATA_DIR=C:\ProgramData\Yathi Pumps PDI\Data
PDI_DATABASE_PATH=C:\ProgramData\Yathi Pumps PDI\Data\pdi_system.db
PDI_UPLOAD_DIR=C:\ProgramData\Yathi Pumps PDI\Data\Uploads
PDI_TEMPLATE_STORAGE_DIR=C:\ProgramData\Yathi Pumps PDI\Data\Templates
PDI_REPORTS_DIR=C:\ProgramData\Yathi Pumps PDI\Data\Reports
PDI_LOG_DIR=C:\ProgramData\Yathi Pumps PDI\Logs
PDI_BACKUP_DIR=C:\ProgramData\Yathi Pumps PDI\Backups
PDI_LOG_MAX_BYTES=10485760
PDI_LOG_BACKUP_COUNT=10

MAX_UPLOAD_BYTES=26214400
MAX_BACKUP_IMPORT_BYTES=1073741824

# Enter a company-owned Gemini key locally. It stays on this backend host.
GEMINI_API_KEY=replace-with-company-managed-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_EXTRACTION_TIMEOUT_SECONDS=90

# Leave email values empty until n8n/email is installed and tested with an internal recipient.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_FROM_EMAIL=
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
GMAIL_ALLOWED_FROM_EMAILS=

# The reverse proxy is the only employee-facing listener.
HOST=127.0.0.1
PORT=8765
